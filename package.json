{
  "name": "ruijinen-block-patterns-r001-corp",
  "description": "類人猿 企業サイト向けパターン集のパッケージです",
  "author": "mgn",
  "license": "GPL-2.0+",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "export:wp-content:themes": "npm run cli cp -- -r wp-content/themes .export/wp-content",
    "export:wp-content:uploads": "npm run cli cp -- -r wp-content/uploads .export/wp-content",
    "export:wp-content": "npm run cli rm -- -rf .export/wp-content && mkdir -p .export/wp-content/uploads && run-p export:wp-content:*",
    "export:db": "mkdir -p .export/sql && npm run wp db -- export .export/sql/local.sql",
    "export": "run-p export:*",
    "import:wp-content:themes": "npm run cli cp -- -r .export/wp-content/themes wp-content",
    "import:wp-content:uploads": "npm run cli cp -- -r .export/wp-content/uploads wp-content",
    "import:wp-content": "run-p import:wp-content:*",
    "import:db": "npm run wp db -- import .export/sql/local.sql",
    "import": "run-p import:*",
    "wp-env": "wp-env",
    "start": "wp-env start && open http://localhost:1011",
    "stop": "npm run export && wp-env stop",
    "cli": "wp-env run cli",
    "wp": "wp-env run cli wp",
    "clean": "run-s 'clean:**'",
    "clean:all": "del-cli \"dist/**/*\" -f",
    "build": "run-s 'clean build:**'",
    "build:sass": "sass src/css:dist/css block-styles:dist/css/block-styles patterns:dist/css/patterns --no-error-css --no-source-map",
    "build:postcss": "postcss dist/css --base ./dist/css -d dist/css",
    "build:img": "node optimize-images.mjs",
    "debug:css": "sass src/css:dist/css block-styles:dist/css/block-styles patterns:dist/css/patterns",
    "watch": "run-s 'watch:css'",
    "watch:css": "sass src/css:dist/css block-styles:dist/css/block-styles patterns:dist/css/patterns --no-error-css --no-source-map --watch | postcss dist/css --base ./dist/css -d dist/css --watch",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.js --project=editing",
    "test:e2e:report": "playwright show-report tests/e2e/artifacts/report",
    "test:e2e:user": "wp-env run cli wp user get e2e --field=ID || wp-env run cli wp user create e2e e2e@example.test --role=administrator --user_pass=password",
    "test:vrt": "playwright test --config tests/e2e/playwright.config.js --project=visual",
    "test:vrt:update": "playwright test --config tests/e2e/playwright.config.js --project=visual --update-snapshots"
  },
  "browserslist": [
    ">0.25% in JP",
    "not ie < 11",
    "iOS >= 10",
    "Android >= 4.4"
  ],
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@wordpress/e2e-test-utils-playwright": "^3.2.0",
    "@wordpress/env": "^12.1.0",
    "cssnano": "^9.9.0",
    "del-cli": "^8.0.1",
    "npm-run-all2": "^9.0.4",
    "postcss": "^8.5.32",
    "postcss-cli": "^12.0.0",
    "postcss-sort-media-queries": "^6.7.1",
    "postcss-sorting": "^10.0.0",
    "sass": "^1.107.1",
    "sharp": "^0.35.5"
  },
  "overrides": {
    "isomorphic-git": "^1.38.6",
    "qs": "^6.16.1",
    "rimraf": "^6.1.4"
  }
}
